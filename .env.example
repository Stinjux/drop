# ─────────────────────────────────────────────────────────────────────────────
# Copier en .env.local (ignoré par Git) puis compléter. AUCUN secret ici.
# En production, définir ces variables dans les « secrets » de l'hébergeur.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique du site (HTTPS en production). Sert aux URL de retour Stripe.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — commencer avec un compte/environnement de TEST séparé.
# Privilégier une clé RESTREINTE (rk_test_…) avec les permissions « Checkout Sessions : écriture » et « Coupons : écriture ».
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…) : Dashboard > Développeurs > Webhooks, ou `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Stripe Tax : laisser false tant que la configuration fiscale et les inscriptions
# (TPS/TVH, TVQ…) ne sont pas vérifiées dans le Dashboard Stripe.
STRIPE_TAX_ENABLED=false
# Garde-fou : les clés live (sk_live_/rk_live_) sont refusées tant que ce n'est pas « true ».
STORE_ALLOW_LIVE_PAYMENTS=false

# Base de données (libSQL / SQLite).
# Local : fichier. Production serverless : base distante libsql://… (ex. Turso) + jeton.
DATABASE_URL=file:./data/store.db
DATABASE_AUTH_TOKEN=

# Administration (/admin). Mot de passe : 12 caractères minimum.
ADMIN_PASSWORD=
# Secret de signature des sessions admin : 32 caractères minimum (ex. `openssl rand -base64 48`).
ADMIN_SESSION_SECRET=

# Courriels transactionnels via Resend (https://resend.com). Sans ces deux variables,
# AUCUN courriel n'est envoyé (statut « non configuré » visible dans l'admin).
RESEND_API_KEY=
EMAIL_FROM="Boréa <commandes@votre-domaine.ca>"
EMAIL_REPLY_TO=
# Copie cachée de chaque confirmation de commande (facultatif).
ORDER_NOTIFICATION_EMAIL=

# En-tête contenant l'IP réelle du client selon l'hébergeur (limitation de débit).
# Vercel/la plupart des proxys : x-forwarded-for ; Cloudflare : cf-connecting-ip.
CLIENT_IP_HEADER=x-forwarded-for

# Tests uniquement : redirige le SDK Stripe vers stripe-mock (ignoré avec une clé live).
# STRIPE_API_BASE_FOR_TESTS=http://localhost:12111
